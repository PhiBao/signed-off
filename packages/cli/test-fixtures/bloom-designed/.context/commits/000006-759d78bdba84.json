b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","rationale":"[applicability] Not applicable: the scenario stops before checkout and does not exercise account-creation requirements.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b52925eb52b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","rationale":"[applicability] Not applicable: the scenario does not need to enter the guest checkout path.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b52925eb52b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","rationale":"[applicability] Not applicable: the scenario is blocked before checkout success.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b52925eb52b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","rationale":"[applicability] Not applicable: the scenario never reaches an order confirmation.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b52925eb52b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","rationale":"[applicability] Applicable: the scenario directly tests the out-of-stock add restriction.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b52925eb52b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","rationale":"[applicability] Not applicable: the scenario does not reach delivery-date selection.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b52925eb52b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","rationale":"[applicability] Not applicable: no successful order is placed, so no order email is expected.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b52925eb52b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","rationale":"[applicability] Not applicable: the source promise is end-to-end completion on a phone, while this scenario isolates stock gating before checkout.","by":{"kind":"ai","id":"design-agent"}}],"design_of":{"uc_cid":"sha256:b52925eb52b750df1d86020d465f063e6e9c235f342e861d0361d8b83e30aa65","engine":"design@1"},"event_ids":["design-